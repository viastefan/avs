# Kontaktformular — Versand über Resend (https://resend.com)
#
# Ohne RESEND_API_KEY wird keine Anfrage automatisch verschickt. Das
# Formular zeigt dann eine vorbereitete E-Mail an info@airport-verpackungen.de
# an, die der Absender mit einem Klick aus seinem Mailprogramm sendet.
#
# Auf Vercel setzen unter: Project avs → Settings → Environment Variables

RESEND_API_KEY=

# Empfänger der Anfragen. Ohne Angabe: info@airport-verpackungen.de
CONTACT_TO_EMAIL=info@airport-verpackungen.de

# Absender. Muss eine bei Resend verifizierte Domain sein.
# Zum Testen funktioniert onboarding@resend.dev.
CONTACT_FROM_EMAIL="AVS Website <onboarding@resend.dev>"

# Formulierungshilfe im Anfrageformular (Anthropic / Claude)
#
# Ohne ANTHROPIC_API_KEY blendet das Formular die Schaltfläche
# "Für mich formulieren" automatisch aus — alles andere funktioniert weiter.
# Schlüssel unter https://console.anthropic.com/settings/keys

ANTHROPIC_API_KEY=
